---
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import { Image } from "astro:assets";
const { slug, title, cover, description, mainTech } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  aria-label={`View ${title} project`}
  class="group grid gap-6 border-t border-border-custom py-8 first:border-t-0 first:pt-0 md:grid-cols-[minmax(0,1.3fr)_16rem] md:items-start"
>
  <div class="relative z-10 flex flex-col gap-3">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="flex w-full justify-between">
          <div
            class="flex items-start gap-2 text-ink transition-colors duration-150 group-hover:text-accent"
          >
            <h3 class="font-display text-xl leading-tight">{title}</h3>
            <ArrowUpRight
              size={20}
              strokeWidth={1.5}
              class="pt-1 text-ink-muted transition-colors duration-150 group-hover:text-accent"
            />
          </div>
        </div>
        <p class="text-sm text-ink-muted leading-relaxed">
          {description}
        </p>
      </div>

      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {
          mainTech.map((tag: string) => {
            return (
              <li class="font-mono text-xs uppercase tracking-[0.12em] text-ink-muted">
                {tag}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <div class="relative block overflow-hidden bg-border-custom">
    <Image
      src={cover}
      alt={title}
      class="w-full object-cover transition-transform duration-300 md:h-full"
      loading="lazy"
      decoding="async"
    />
  </div>
</a>
