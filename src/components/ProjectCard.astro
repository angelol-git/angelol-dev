---
import { ArrowUpRight, Globe } from "@lucide/astro";
import Github from "./icons/Github.astro";
import { Image } from "astro:assets";
const { slug, title, url, github, cover, description, mainTech, background } =
  Astro.props;
---

<article
  class="group cursor-pointer grid gap-6 border-t border-border-custom py-8 first:border-t-0 first:pt-0 md:grid-cols-[minmax(0,1.3fr)_16rem] md:items-start"
>
  <div class="relative z-10 flex flex-col gap-3">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="flex w-full justify-between">
          <a
            href={`/projects/${slug}`}
            aria-label={`View ${title} project`}
            class="flex items-start gap-2 text-ink transition-colors duration-150 group-hover:text-accent"
          >
            <h3 class="font-display text-xl leading-tight">{title}</h3>
            <ArrowUpRight
              size={20}
              stroke-width={1.5}
              class="pt-1 text-ink-muted transition-colors duration-150 group-hover:text-accent"
            />
          </a>
        </div>
        <p class="text-sm text-ink-muted leading-relaxed">
          {description}
        </p>
      </div>

      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {
          mainTech.map((tag: string) => {
            return (
              <li class="font-mono text-xs uppercase tracking-[0.12em] text-ink-muted">
                {tag}
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="mt-auto flex flex-col gap-4">
      <div class="relative z-20 flex gap-4">
        {
          url && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-accent transition-colors duration-150"
            >
              <Globe size={18} stroke-width={1.5} />
            </a>
          )
        }

        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-accent transition-colors duration-150"
            >
              <Github />
            </a>
          )
        }
      </div>
    </div>
  </div>

  <a
    href={`/projects/${slug}`}
    aria-hidden="true"
    tabindex="-1"
    class="relative block overflow-hidden bg-border-custom"
  >
    <Image
      src={cover}
      alt={title}
      class="h-56 w-full object-cover transition-transform duration-300 md:h-full"
      loading="lazy"
      decoding="async"
    />
  </a>
</article>
