---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Github from "../components/icons/Github.astro";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
const selectedWork = sortedProjects.filter(
  (project) => project.data.section === "selected",
);
const projectWork = sortedProjects.filter(
  (project) => project.data.section === "projects",
);
---

<Layout
  title="Angelo Ladores"
  description="Full-Stack Developer building thoughtful web applications with React, Node, and modern web technologies. View my portfolio of full-stack applications and frontend projects."
>
  <main class="flex flex-col w-full h-full max-w-2xl gap-10">
    <div class="flex sm:justify-between sm:flex-row flex-col gap-2">
      <div class="flex flex-col gap-1">
        <p class="font-mono text-sm text-ink-muted">Full-Stack Developer</p>
        <h1 class="text-3xl font-display text-in text-nowrap">
          Angelo Ladores
        </h1>
      </div>
      <div class="flex gap-4">
        <a
          href="https://github.com/angelol-git"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 hover:text-accent transition-colors duration-150"
        >
          <Github />
          Github
        </a>
      </div>
    </div>
    <div class="flex flex-col gap-3 text-ink-light">
      <p>
        Located in Ontario, Canada. My work includes shipped client websites,
        personal projects and open source contributions.
      </p>
      <p>
        My professional work includes client websites like <a
          href="/projects/softlyshaded"
          class="text-accent underline decoration-accent-light">SoftlyShaded</a
        >
        {" "}and a <a
          href="/projects/eladores"
          class="text-accent underline decoration-accent-light"
          >Product Designer Portfolio Website</a
        >.
      </p>
      <p>
        Side projects range from full-stack applications such as <a
          href="/projects/recipe"
          class="text-accent underline decoration-accent-light">Rambutan</a
        >, a recipe card manager for creating, saving, and editing recipes from
        links or raw text. To front end Chrome Extensions such as <a
          href="/projects/measured"
          class="text-accent underline decoration-accent-light">Measured</a
        >, which makes clothing measurements easier to compare while shopping.
      </p>
      <p>
        I also contribute to <a
          href="https://github.com/RetroAchievements/RAWeb"
          class="text-accent underline decoration-accent-light">RAWeb</a
        > an open source web platform for <a
          href="https://retroachievements.org/"
          class="text-accent underline decoration-accent-light"
          >RetroAchievements</a
        >, a community run achievement tracking platform for retro games.
      </p>
    </div>
    {
      selectedWork.length > 0 && (
        <section class="flex flex-col gap-6">
          <h2 class="font-mono uppercase tracking-[0.15em] text-ink-muted">
            Selected Work
          </h2>
          <div class="flex flex-col">
            {selectedWork.map((project) => (
              <ProjectCard
                slug={project.data.slug}
                title={project.data.title}
                description={project.data.description}
                url={project.data.url}
                github={project.data.github}
                cover={project.data.cover}
                mainTech={project.data.mainTech}
                background={project.data.background}
              />
            ))}
          </div>
        </section>
      )
    }
    {
      projectWork.length > 0 && (
        <section class="flex flex-col gap-6">
          <h2 class="font-mono uppercase tracking-[0.15em] text-ink-muted">
            Projects
          </h2>
          <div class="flex flex-col">
            {projectWork.map((project) => (
              <ProjectCard
                slug={project.data.slug}
                title={project.data.title}
                description={project.data.description}
                url={project.data.url}
                github={project.data.github}
                cover={project.data.cover}
                mainTech={project.data.mainTech}
                background={project.data.background}
              />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
